# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# A single key works for both APIs as long as BOTH are enabled
# on the same Google Cloud project:
#   1. Generative Language API (for Gemini)
#   2. Google Drive API (for reading the public folder)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_DRIVE_API_KEY=your_google_console_api

LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Optional: use a separate key for Drive if you prefer to keep them isolated
# GOOGLE_DRIVE_API_KEY=your_drive_api_key_here

# --- Model selection ---
# Model used by the ADK pipeline agents. Default: gemini-2.0-flash-lite
# To switch to OpenAI (when Gemini quota is exhausted), set:
#   LLM_MODEL=openai/gpt-4o-mini
#   OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gemini-2.0-flash-lite
# OPENAI_API_KEY=your_openai_api_key_here

# Model used by the PDF vision tools (must stay on Gemini — native PDF support).
# Requires GOOGLE_API_KEY regardless of LLM_MODEL above.
# VISION_MODEL=gemini-2.0-flash-lite
