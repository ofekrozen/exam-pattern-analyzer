# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# A single key works for both APIs as long as BOTH are enabled
# on the same Google Cloud project:
#   1. Generative Language API (for Gemini)
#   2. Google Drive API (for reading the public folder)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional: use a separate key for Drive if you prefer to keep them isolated
# GOOGLE_DRIVE_API_KEY=your_drive_api_key_here
